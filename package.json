{
  "name": "@escute/player",
  "version": "1.0.0",
  "description": "Player de audio/video reutilizavel para React: arquivos locais, HLS, YouTube, SoundCloud, Vimeo, Spotify e embeds, com fila, repeticao, Media Session e atalhos. Sem dependencia de banco, storage ou framework de roteamento.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-player": "^3.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/esm/index.js",
  "keywords": [
    "react",
    "player",
    "audio",
    "video",
    "music",
    "podcast",
    "youtube",
    "soundcloud",
    "hls",
    "media-session",
    "queue",
    "playlist",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisecloudsolutions/escute-player.git"
  },
  "homepage": "https://github.com/arisecloudsolutions/escute-player#readme",
  "bugs": {
    "url": "https://github.com/arisecloudsolutions/escute-player/issues"
  },
  "author": "Escute",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-player": "^3.4.0"
  }
}
